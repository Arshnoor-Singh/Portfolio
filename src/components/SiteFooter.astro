---
import { EMAIL, SITE_NAME, SITE_ROLE, withBase } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__inner">
      <div>
        <p class="site-footer__brand">{SITE_NAME}</p>
        <div class="site-footer__meta">
          <span>{SITE_ROLE}</span>
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>
      </div>

      <nav class="site-footer__nav" aria-label="Footer">
        <a href={withBase('work/')}>Work</a>
        <a href={withBase('about/')}>About</a>
        <a href={withBase('#contact')}>Contact</a>
        <a href="#top">Back to top ↑</a>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <span>© {year} {SITE_NAME}</span>
      <span>Unity / Unreal / C# / C++ / Blender</span>
    </div>
  </div>
</footer>
