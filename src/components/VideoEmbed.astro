---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { youtubeUrl } from '../lib/site';

interface Props {
  title: string;
  youtubeId: string;
  poster: ImageMetadata;
  posterAlt: string;
}

const { title, youtubeId, poster, posterAlt } = Astro.props;
---

<div class="video-card">
  <button
    type="button"
    class="video-card__frame"
    data-video-id={youtubeId}
    data-video-title={title}
    aria-label={`Play video: ${title}`}
  >
    <Image
      src={poster}
      alt={posterAlt}
      width={1280}
      format="webp"
      quality={82}
      loading="lazy"
    />
    <span class="video-card__play" aria-hidden="true">
      <span>▶</span>
    </span>
    <span class="video-card__label">{title}</span>
  </button>

  <div class="video-card__meta">
    <span>YouTube</span>
    <a href={youtubeUrl(youtubeId)} target="_blank" rel="noopener noreferrer">
      Open on YouTube ↗
    </a>
  </div>
</div>
